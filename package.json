{
  "name": "unierp-corporate-website",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate Marketing Website for UniERP SaaS Platform",
  "scripts": {
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4001",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "pnpm tsx --test lib/rbac.test.ts && pnpm test:e2e",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:rbac": "tsx --test lib/rbac.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pg": "^8.20.0",
    "@types/three": "^0.185.3",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.4",
    "lenis": "^1.3.25",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}
