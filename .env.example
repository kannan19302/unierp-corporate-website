# ERP Application Platform URL (legacy fallback — moving to per-tenant
# SiteSettings.erpAppUrl in Phase 4; still read by lib/site-data.ts until then)
NEXT_PUBLIC_ERP_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database (local dev via docker-compose.yml — postgres on host port 5433)
DATABASE_URL="postgresql://unerp_marketing:unerp_marketing_password@localhost:5433/unerp_marketing?schema=public"

# Auth — JWT_SECRET stays a true env var forever: middleware.ts runs on the
# Edge runtime and cannot load Prisma, so the admin session token must be
# verifiable without a DB call. Never make this DB-editable.
JWT_SECRET=change-me-to-a-long-random-string

# Encryption key for at-rest secrets stored in the Setting table (Phase 2).
# Must be exactly 64 hex characters (32 bytes) for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Env-only for the same reason as JWT_SECRET — it can't encrypt itself.
ENCRYPTION_KEY=change-me-to-64-hex-characters

# Seed admin + tenant (used only by prisma/seed to create the first tenant
# and its first super-admin)
SEED_ADMIN_EMAIL=superadmin@unierp.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_TENANT_SLUG=unierp
SEED_DEMO_TENANT=false

# Multi-tenancy: local dev has no real custom domains, so requests that don't
# match a known TenantDomain fall back to this domain (non-production only).
DEV_TENANT_DOMAIN=localhost
# When true, an admin JWT's embedded tenantHost claim must match the request's
# Host header (rejected in middleware with no DB call otherwise). Set to
# 'false' only for local multi-host testing convenience.
ENFORCE_TENANT_HOST_MATCH=true

# Platform-level tenant provisioning API (app/api/platform/tenants). Leave
# blank to keep the route inert (404s unconditionally when unset).
PLATFORM_ADMIN_TOKEN=

# Email (Resend) — DB-overridable per tenant from /admin/settings once Phase 2
# lands; these remain the env-level fallback defaults.
RESEND_API_KEY=
RESEND_FROM_EMAIL="UniERP <notifications@unierp.com>"
ADMIN_NOTIFICATION_EMAIL=sales@unierp.com

# AI Chat (local Ollama) — also DB-overridable per tenant via /admin/settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
