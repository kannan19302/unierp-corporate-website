# Local development image — UniERP Marketing Site (Plane 0)
FROM node:22-alpine

RUN apk add --no-cache openssl libc6-compat wget curl
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

EXPOSE 4001

CMD ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm prisma db push && pnpm db:seed && pnpm dev"]
