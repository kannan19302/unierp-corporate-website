# Local development image — matches the ERPSys sibling repo's dev-container
# pattern (bind-mounted source, polling file watch for Windows Docker Desktop).
FROM node:22-alpine

RUN apk add --no-cache openssl libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

EXPOSE 3002

CMD ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm prisma generate && pnpm dev"]
